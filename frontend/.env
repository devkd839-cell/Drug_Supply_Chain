# ── Contract address ─────────────────────────────────────────────────────────
# This is the default address Hardhat assigns to the FIRST deployed contract
# on a fresh local node (account 0 / nonce 0). It will match after you run:
#   cd blockchain && npm run deploy
# If your address is different (e.g. you deployed more than once), update it.
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ── Network ───────────────────────────────────────────────────────────────────
VITE_NETWORK=localhost
VITE_CHAIN_ID=31337

# ── Admin address (optional) ──────────────────────────────────────────────────
# If set, this wallet gets the "Admin" nav regardless of registration.
# Leave blank to rely solely on contract owner detection (recommended).
VITE_ADMIN_ADDRESS=
